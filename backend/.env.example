# PR Risk Scorer — backend configuration (API server and worker read the same file).
# Copy to backend/.env. Values below run the app locally in demo mode with the
# services from docker-compose.yml; no GitHub or OpenAI credentials are needed.

NODE_ENV=development
LOG_LEVEL=info
HOST=127.0.0.1
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/pr_risk_scorer
REDIS_URL=redis://127.0.0.1:6379
# Public origin of the dashboard. State-changing API calls must come from this Origin.
FRONTEND_URL=http://localhost:3000
# Set to true only behind a trusted reverse proxy (uses X-Forwarded-For for client IPs).
TRUST_PROXY=false

# ---- Dashboard login (single workspace admin) -------------------------------
ADMIN_USERNAME=admin
# Generate with: pnpm --filter backend auth:hash-password
# The value below is the hash of the LOCAL EXAMPLE password "local-dev-password-change-me".
# It is rejected when NODE_ENV=production.
ADMIN_PASSWORD_HASH=scrypt$17$8$1$yb2WYx_F2tjBN5OOXwGUIQ$bBoUsaCQatOP5W1yoYWPZ5t0wLCxUPksJQiGkVe-_5vNzvmlIRWMKPeZqNNgCBSCydcPkgbVveARxXbbzeJoew
SESSION_TTL_HOURS=12

# ---- Demo data (development only; forbidden in production) -------------------
DEMO_ENABLED=true

# ---- GitHub App (live mode) --------------------------------------------------
# false = local demo mode: webhooks answer 503 and no GitHub calls are made.
GITHUB_ENABLED=false
GITHUB_APP_ID=
# Either the PEM (single line with \n escapes is fine) or a path to the .pem file.
GITHUB_PRIVATE_KEY=
GITHUB_PRIVATE_KEY_PATH=
# At least 16 characters; must match the webhook secret in the GitHub App settings.
GITHUB_WEBHOOK_SECRET=
# Installation ids this workspace may process and show (comma separated). Required in live mode.
WORKSPACE_INSTALLATION_IDS=
# Optional allowlist of owner/name repositories within those installations.
WORKSPACE_REPOSITORIES=
# GitHub Enterprise Server: https://<host>/api/v3
GITHUB_API_URL=https://api.github.com
# Post/update one analysis comment per PR (requires AI_ENABLED=true). Keep false in development.
GITHUB_POST_COMMENTS=false

# ---- Optional AI review (paid; keep disabled in development and CI) ---------
AI_ENABLED=false
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=
AI_TIMEOUT_MS=20000

# ---- Worker ------------------------------------------------------------------
WORKER_CONCURRENCY=5
DELIVERY_MAX_ATTEMPTS=6
DISPATCHER_INTERVAL_MS=15000
