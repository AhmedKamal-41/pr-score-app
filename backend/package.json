{
  "name": "backend",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "concurrently -n api,worker -c blue,magenta \"pnpm dev:api\" \"pnpm dev:worker\"",
    "dev:api": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "prisma generate --no-hints >/dev/null && tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit --coverage",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "pnpm build && pnpm --filter frontend build && vitest run --project e2e",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:check": "prisma validate && prisma migrate diff --from-migrations prisma/migrations --to-schema-datamodel prisma/schema.prisma --shadow-database-url \"$SHADOW_DATABASE_URL\" --exit-code",
    "db:seed": "tsx src/cli/seed-demo.ts",
    "db:studio": "prisma studio",
    "auth:hash-password": "tsx src/cli/hash-password.ts",
    "deliveries:recover": "tsx src/cli/recover-deliveries.ts",
    "report:legacy-identity": "tsx src/cli/report-legacy-identity.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@octokit/auth-app": "^6.1.4",
    "@octokit/rest": "^20.1.2",
    "@octokit/webhooks-methods": "^6.0.0",
    "@prisma/client": "5.22.0",
    "bullmq": "^5.81.5",
    "dotenv": "^16.6.1",
    "fastify": "^5.12.5",
    "fastify-plugin": "^5.1.0",
    "fastify-raw-body": "^5.0.0",
    "ioredis": "^5.8.2",
    "openai": "^4.104.0",
    "pino": "^9.14.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^9.2.4",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "pg": "^8.23.0",
    "pino-pretty": "^13.1.3",
    "prisma": "5.22.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "~8.70.0",
    "vitest": "^4.1.11"
  },
  "prisma": {
    "seed": "tsx src/cli/seed-demo.ts"
  }
}
