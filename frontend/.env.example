# PR Risk Scorer — dashboard configuration. Copy to frontend/.env.local.
# Server-side only: the backend URL used by server rendering and by the
# same-origin /api proxy. Nothing here is exposed to the browser, and no
# secret belongs in a NEXT_PUBLIC_* variable.
API_INTERNAL_URL=http://127.0.0.1:4000
NEXT_TELEMETRY_DISABLED=1
